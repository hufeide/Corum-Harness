{
  "name": "@corum/corum-ide-integrations-ui",
  "version": "0.1.0",
  "description": "corum 集成中心 · 「插件」页（design.pen yXkOK F1）：GPT 式插件市场（公开|个人 分段 + 分类分组卡片流 + 「+」即装 + 添加▾ 三来源）与已装管理（启停/配置/卸载，系统插件 runtime 不外露）。内容页组件可注册进集成中心父槽；父槽由 PR4 提供，故挂载行先注释。",
  "private": true,
  "type": "module",
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": false
    }
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b && tsdown && node scripts/inline-css.mjs",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@corum/corum-ui-base": "workspace:*",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.3-alpha.1",
    "lucide-react": "^0.460.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@tsdown/css": "^0.22.14",
    "@types/react": "~18.3.31",
    "@types/react-dom": "^18.3.7",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
