{
  "name": "@corum/corum-ollama",
  "version": "0.1.0",
  "description": "corum 本地 LLM 插件：探测/管理本机推理引擎（Ollama，Apple Silicon 友好），为 AI 润色等轻量任务提供本地模型能力",
  "private": true,
  "type": "module",
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    }
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b && tsdown",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-connection": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.3-alpha.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "@types/react": "^18.0.0"
  }
}
