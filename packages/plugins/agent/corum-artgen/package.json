{
  "name": "@corum/corum-artgen",
  "version": "0.1.0",
  "description": "corum 本地文生图插件：基于 stable-diffusion.cpp 单体二进制，三平台支持 SD/Flux 文生图",
  "private": true,
  "type": "module",
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@corum/corum-api-remotes"
      ],
      "immediately": true
    }
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b && tsdown",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@corum/corum-api-remotes": "workspace:*",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.7-rc.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "@types/react": "^18.0.0"
  }
}
